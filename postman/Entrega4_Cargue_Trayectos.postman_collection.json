  "item": [
    {
      "name": "1. Login (Guarda el JWT automáticamente)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set('jwtToken', jsonData.token);",
              "        console.log('JWT guardado en variable de colección jwtToken');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"ag9998887771\",\n  \"password\": \"2ab43a6b\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Autentica al usuario ag9998887771 y guarda automáticamente el token JWT en la variable de colección `{{jwtToken}}`."
      },
      "response": []
    },
    {
      "name": "2. Cargar Archivo Excel (.xlsx) - Exitoso (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "archivo",
              "type": "file",
              "src": [],
              "description": "Selecciona aquí postman/cargue_exitoso.xlsx o postman/cargue_mixto.xlsx"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/trayectos/cargues",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trayectos",
            "cargues"
          ]
        },
        "description": "Sube el archivo Excel (.xlsx) con la hoja 'Trayectos', ejecuta sp_cargue, sp_validacion y sp_procesado, y retorna HTTP 201 con el CargueResultadoDTO."
      },
      "response": []
    },
    {
      "name": "3. Verificar Ruta Procesada en Trayectos (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}",
            "type": "text"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trayectos/rutas/{{codigoRuta}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trayectos",
            "rutas",
            "{{codigoRuta}}"
          ]
        },
        "description": "Consulta en la tabla definitiva `trayecto` una ruta que haya quedado en estado PROCESADO."
      },
      "response": []
    },
    {
      "name": "4. Prueba Error 401 - Sin Token JWT",
